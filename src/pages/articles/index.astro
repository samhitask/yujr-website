---
import { client } from '../../lib/sanity';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const articles = await client.fetch(`
  *[_type == "article" && draft != true] | order(pubDate desc) {
    _id,
    title,
    "slug": slug.current,
    description,
    author,
    pubDate,
    image,
    tags
  }
`);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title="Articles" description="Browse articles from the Yale Undergraduate Journal of Religion" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent: #c74a00;
      --accent-rgb: 199, 74, 0;
      --text-heading: #1a1a1a;
      --text: #333333;
      --text-muted: #666666;
      --border-color: #e8e8e8;
      --white: #ffffff;
      --background-light: #fafafa;
    }
    
    * {
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Lato', sans-serif;
      margin: 0;
      padding: 0;
      background-color: var(--white);
    }
    
    .hero-header {
      position: relative;
      padding: 8rem 1rem 6rem;
      text-align: center;
      background-image: url('/images/uploads/guillaume-bleyer-372uM1cIQqE-unsplash.jpg');
      background-size: cover;
      background-position: center;
      color: var(--white);
      margin-bottom: 0;
      overflow: hidden;
    }
    
    .hero-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 1;
    }
    
    .hero-header h1 {
      position: relative;
      z-index: 2;
      font-family: 'Caudex', Georgia, serif;
      color: #ffffff;
      margin: 0;
      font-size: 3.5rem;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    
    @media (min-width: 768px) {
      .hero-header h1 {
        font-size: 4.5rem;
      }
    }
    
    .container {
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      padding: 4rem clamp(1rem, 5vw, 2rem);
    }
    
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
      font-size: 1.125rem;
    }
    
    .articles-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }
    
    .article-item {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 2rem;
      padding: 2.5rem 0;
      border-bottom: 1px solid var(--border-color);
      transition: background-color 0.3s ease;
    }
    
    .article-item:hover {
      background-color: rgba(var(--accent-rgb), 0.02);
    }
    
    .article-item:first-child {
      grid-template-columns: 1fr;
      padding: 3rem 0;
      background-color: var(--background-light);
      padding: 3rem 2.5rem;
      margin: -2rem -2.5rem 0;
      border-bottom: 3px solid var(--accent);
    }
    
    .article-item:first-child .date-column {
      display: none;
    }
    
    .article-item:first-child .article-title {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    
    .article-item:first-child .article-description {
      font-size: 1.2rem;
      max-width: 800px;
    }
    
    .article-item:first-child .featured-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1rem;
      padding: 0.5rem 1rem;
      border: 2px solid var(--accent);
      border-radius: 4px;
    }
    
    .date-column {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-top: 0.25rem;
    }
    
    .pub-date {
      font-family: 'Caudex', Georgia, serif;
      text-align: center;
    }
    
    .date-month {
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    
    .date-day {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--text-heading);
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    
    .date-year {
      font-size: 0.875rem;
      color: var(--text-muted);
      font-weight: 400;
    }
    
    .content-column {
      min-width: 0;
    }
    
    .article-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    
    .featured-badge {
      display: none;
    }
    
    .category {
      font-family: 'Lato', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent);
      margin-bottom: 0.75rem;
      display: inline-block;
    }
    
    .article-title {
      font-family: 'Caudex', Georgia, serif;
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--text-heading);
      margin: 0 0 0.75rem 0;
      transition: color 0.2s ease;
    }
    
    .article-link:hover .article-title {
      color: var(--accent);
    }
    
    .article-meta {
      font-family: 'Lato', sans-serif;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin: 0 0 0.75rem 0;
    }
    
    .author {
      font-weight: 700;
      color: var(--text);
    }
    
    .article-description {
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      line-height: 1.65;
      color: var(--text);
      margin: 0;
    }
    
    @media (max-width: 768px) {
      .hero-header {
        padding: 5rem 1rem 3.5rem;
      }
      
      .hero-header h1 {
        font-size: 2.5rem;
      }
      
      .container {
        padding: 2rem 1rem;
      }
      
      .article-item {
        grid-template-columns: 1fr;
        gap: 1rem;
        padding: 2rem 0;
      }
      
      .article-item:first-child {
        margin: 0;
        padding: 2rem 1.5rem;
      }
      
      .article-item:first-child .article-title {
        font-size: 2rem;
      }
      
      .article-item:first-child .article-description {
        font-size: 1.05rem;
      }
      
      .date-column {
        flex-direction: row;
        align-items: baseline;
        gap: 0.5rem;
        padding-top: 0;
      }
      
      .date-day {
        font-size: 1.5rem;
      }
      
      .date-month,
      .date-year {
        font-size: 0.8rem;
      }
      
      .article-title {
        font-size: 1.5rem;
      }
    }
  </style>
</head>

<body>
  <Header />
  
  <div class="hero-header">
    <h1>Articles</h1>
  </div>
  
  <main class="container">
    {articles.length === 0 ? (
      <div class="empty-state">
        <p>No articles yet. Create your first article in Sanity Studio!</p>
      </div>
    ) : (
      <div class="articles-grid">
        {articles.map((article, index) => {
          const date = new Date(article.pubDate);
          const month = date.toLocaleDateString('en-US', { month: 'short' });
          const day = date.getDate();
          const year = date.getFullYear();
          
          return (
            <article class="article-item">
              <div class="date-column">
                <div class="pub-date">
                  <div class="date-month">{month}</div>
                  <div class="date-day">{day}</div>
                  <div class="date-year">{year}</div>
                </div>
              </div>
              
              <div class="content-column">
                <a href={`/articles/${article.slug}`} class="article-link">
                  {index === 0 && <span class="featured-badge">Latest</span>}
                  {article.tags && article.tags.length > 0 && (
                    <div class="category">{article.tags[0]}</div>
                  )}
                  <h3 class="article-title">{article.title}</h3>
                  <p class="article-meta">
                    <span class="author">{article.author}</span>
                  </p>
                  {article.description && (
                    <p class="article-description">{article.description}</p>
                  )}
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </main>
  
  <Footer />
</body>
</html>