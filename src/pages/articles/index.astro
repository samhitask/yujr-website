---
import { client } from '../../lib/sanity';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const articles = await client.fetch(`
  *[_type == "article" && draft != true] | order(pubDate desc) {
    _id,
    title,
    "slug": slug.current,
    description,
    author,
    pubDate,
    image,
    tags
  }
`);

// Get author filter from URL params
const url = new URL(Astro.request.url);
const authorFilter = url.searchParams.get('author');

// Filter articles by author if specified
const filteredArticles = authorFilter 
  ? articles.filter(article => article.author === authorFilter)
  : articles;

const pageTitle = authorFilter 
  ? `Articles by ${authorFilter}` 
  : 'Articles';

const pageSubtitle = authorFilter
  ? `All articles written by ${authorFilter}`
  : 'Essays and commentary from the Yale Undergraduate Journal of Religion';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title="Articles" description="Browse articles from the Yale Undergraduate Journal of Religion" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent: #c74a00;
      --accent-rgb: 199, 74, 0;
      --text-heading: #1a1a1a;
      --text: #333333;
      --text-muted: #666666;
      --border-color: #e0e0e0;
      --white: #ffffff;
      --background-light: #fafafa;
    }
    
    * {
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Lato', sans-serif;
      margin: 0;
      padding: 0;
      background-color: var(--white);
      color: var(--text);
    }
    
    /* Hero header matching submit page */
    .hero-header {
      position: relative;
      padding: 6rem 1rem 4rem;
      text-align: center;
      background-image: url('/images/uploads/guillaume-bleyer-372uM1cIQqE-unsplash.jpg');
      background-size: cover;
      background-position: center;
      color: var(--white);
      margin-bottom: 2rem;
      overflow: hidden;
    }
    
    .hero-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 1;
    }
    
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 800px;
      margin: 0 auto;
    }
    
    .hero-header h1 {
      font-family: 'Caudex', Georgia, serif;
      color: #ffffff;
      margin: 0 0 1.5rem 0;
      font-size: 3rem;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    
    .hero-subtitle {
      font-family: 'Lato', sans-serif;
      font-size: 1.2rem;
      color: #ffffff;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
      max-width: 600px;
      margin: 0 auto;
      font-weight: 300;
    }
    
    @media (min-width: 768px) {
      .hero-header h1 {
        font-size: 4rem;
      }
    }
    
    .content-container {
      max-width: 800px;
      width: 100%;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 2rem);
    }
    
    .empty-state {
      text-align: center;
      padding: 6rem 2rem;
      color: var(--text-muted);
      font-size: 1.125rem;
    }
    
    /* Featured article - large and prominent */
    .featured-article {
      padding: 4rem 0;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 3rem;
    }
    
    .featured-label {
      font-family: 'Lato', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1.5rem;
      display: block;
    }
    
    .featured-article .article-title {
      font-family: 'Caudex', Georgia, serif;
      font-size: 2.75rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--text-heading);
      margin: 0 0 1.25rem 0;
      letter-spacing: -0.02em;
    }
    
    .featured-article .article-meta {
      font-family: 'Lato', sans-serif;
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 0 0 1.5rem 0;
      font-weight: 400;
    }
    
    .featured-article .author {
      color: var(--text);
      font-weight: 600;
    }
    
    .meta-separator {
      margin: 0 0.5rem;
      color: var(--text-muted);
    }
    
    .featured-article .article-description {
      font-family: 'Lato', sans-serif;
      font-size: 1.25rem;
      line-height: 1.7;
      color: var(--text);
      margin: 0;
      font-weight: 300;
    }
    
    .featured-article .article-link {
      text-decoration: none;
      color: inherit;
      display: block;
      transition: opacity 0.2s ease;
    }
    
    .featured-article .article-link:hover {
      opacity: 0.85;
    }
    
    .featured-article .article-link:hover .article-title {
      color: var(--accent);
    }
    
    /* Regular articles list */
    .articles-list {
      padding-bottom: 4rem;
    }
    
    .article-item {
      padding: 2.5rem 0;
      border-bottom: 1px solid var(--border-color);
    }
    
    .article-item:last-child {
      border-bottom: none;
    }
    
    .article-link {
      text-decoration: none;
      color: inherit;
      display: block;
      transition: opacity 0.2s ease;
    }
    
    .article-link:hover {
      opacity: 0.85;
    }
    
    .category {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 0.75rem;
      display: inline-block;
    }
    
    .article-title {
      font-family: 'Caudex', Georgia, serif;
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--text-heading);
      margin: 0 0 0.75rem 0;
      letter-spacing: -0.01em;
    }
    
    .article-link:hover .article-title {
      color: var(--accent);
    }
    
    .article-meta {
      font-family: 'Lato', sans-serif;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin: 0 0 1rem 0;
      font-weight: 400;
    }
    
    .author {
      font-weight: 600;
      color: var(--text);
    }
    
    .author-link {
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: all 0.2s ease;
    }
    
    .author-link:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }
    
    .pub-date {
      font-style: italic;
    }
    
    .article-description {
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      line-height: 1.7;
      color: var(--text);
      margin: 0;
      font-weight: 300;
    }
    
    @media (max-width: 768px) {
      .hero-header {
        padding: 4rem 1rem 3rem;
      }
      
      .hero-header h1 {
        font-size: 2.5rem;
      }
      
      .hero-subtitle {
        font-size: 1rem;
      }
      
      .featured-article {
        padding: 3rem 0;
        margin-bottom: 2rem;
      }
      
      .featured-article .article-title {
        font-size: 2rem;
      }
      
      .featured-article .article-description {
        font-size: 1.1rem;
      }
      
      .article-item {
        padding: 2rem 0;
      }
      
      .article-title {
        font-size: 1.5rem;
      }
    }
  </style>
</head>

<body>
  <Header />
  
  <div class="hero-header">
    <div class="hero-content">
      <h1>{pageTitle}</h1>
      <p class="hero-subtitle">{pageSubtitle}</p>
    </div>
  </div>
  
  <main id="content" class="content-container">
    {filteredArticles.length === 0 ? (
      <div class="empty-state">
        <p>{authorFilter ? `No articles found by ${authorFilter}.` : 'No articles yet. Create your first article in Sanity Studio!'}</p>
        {authorFilter && (
          <p><a href="/articles" style="color: #c74a00; text-decoration: none; border-bottom: 1px solid #c74a00;">View all articles</a></p>
        )}
      </div>
    ) : (
      <>
        {/* Featured article (most recent) */}
        {filteredArticles.slice(0, 1).map((article) => {
          const date = new Date(article.pubDate);
          const formattedDate = date.toLocaleDateString('en-US', { 
            month: 'long', 
            day: 'numeric', 
            year: 'numeric' 
          });
          
          return (
            <article class="featured-article">
              <a href={`/articles/${article.slug}`} class="article-link">
                <span class="featured-label">Latest</span>
                {article.tags && article.tags.length > 0 && (
                  <div class="category">{article.tags[0]}</div>
                )}
                <h2 class="article-title">{article.title}</h2>
              </a>
              <p class="article-meta">
                {article.author && (
                  <>
                    <a href={`/articles?author=${encodeURIComponent(article.author)}`} class="author-link">
                      {article.author}
                    </a>
                    <span class="meta-separator">·</span>
                  </>
                )}
                <span class="pub-date">{formattedDate}</span>
              </p>
              <a href={`/articles/${article.slug}`} class="article-link">
                {article.description && (
                  <p class="article-description">{article.description}</p>
                )}
              </a>
            </article>
          );
        })}
        
        {/* Rest of the articles */}
        <div class="articles-list">
          {filteredArticles.slice(1).map((article) => {
            const date = new Date(article.pubDate);
            const formattedDate = date.toLocaleDateString('en-US', { 
              month: 'long', 
              day: 'numeric', 
              year: 'numeric' 
            });
            
            return (
              <article class="article-item">
                <a href={`/articles/${article.slug}`} class="article-link">
                  {article.tags && article.tags.length > 0 && (
                    <div class="category">{article.tags[0]}</div>
                  )}
                  <h3 class="article-title">{article.title}</h3>
                </a>
                <p class="article-meta">
                  {article.author && (
                    <>
                      <a href={`/articles?author=${encodeURIComponent(article.author)}`} class="author-link">
                        {article.author}
                      </a>
                      <span class="meta-separator">·</span>
                    </>
                  )}
                  <span class="pub-date">{formattedDate}</span>
                </p>
                <a href={`/articles/${article.slug}`} class="article-link">
                  {article.description && (
                    <p class="article-description">{article.description}</p>
                  )}
                </a>
              </article>
            );
          })}
        </div>
      </>
    )}
  </main>
  
  <Footer />
</body>
</html>