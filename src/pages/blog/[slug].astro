---
import { client, urlFor } from '../../../lib/sanity';
import ArticlePost from '../../../layouts/ArticlePost.astro';

export async function getStaticPaths() {
  const posts = await client.fetch(`
    *[_type == "blogPost" && draft != true] {
      "slug": slug.current
    }
  `);

  return posts.map((post) => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;

const post = await client.fetch(`
  *[_type == "blogPost" && slug.current == $slug][0] {
    title,
    description,
    author,
    pubDate,
    image,
    tags,
    body
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const imageUrl = post.image ? urlFor(post.image).url() : null;

// Collect all footnotes from the body
const footnotes = [];
let footnoteNumber = 1;

if (post.body && Array.isArray(post.body)) {
  post.body.forEach(block => {
    if (block._type === 'block' && block.markDefs) {
      block.markDefs.forEach(markDef => {
        if (markDef._type === 'footnote') {
          if (!footnotes.find(fn => fn.key === markDef._key)) {
            footnotes.push({
              key: markDef._key,
              number: footnoteNumber++,
              text: markDef.text || markDef.note || markDef.content || ''
            });
          }
        }
      });
    }
  });
}

// Helper function to render text with marks
function renderTextWithMarks(child, markDefs) {
  let text = child.text;

  if (child.marks && child.marks.length > 0 && markDefs) {
    child.marks.forEach(markKey => {
      const markDef = markDefs.find(def => def._key === markKey);

      if (markDef) {
        if (markDef._type === 'footnote') {
          const footnote = footnotes.find(fn => fn.key === markDef._key);
          const num = footnote?.number || '*';
          text = `${text}<sup><a href="#footnote-${markDef._key}" id="ref-${markDef._key}" class="footnote-ref">[${num}]</a></sup>`;
        } else if (markDef._type === 'link') {
          text = `<a href="${markDef.href}" target="_blank" rel="noopener noreferrer">${text}</a>`;
        }
      }

      if (markKey === 'strong') {
        text = `<strong>${text}</strong>`;
      } else if (markKey === 'em') {
        text = `<em>${text}</em>`;
      } else if (markKey === 'code') {
        text = `<code>${text}</code>`;
      }
    });
  }

  return text;
}
---

<ArticlePost
  title={post.title}
  description={post.description}
  pubDate={new Date(post.pubDate)}
  author={post.author}
  image={imageUrl}
>
  <div class="article-content">
    {post.body && Array.isArray(post.body) ? (
      <>
        {post.body.map((block) => {
          if (block._type === 'block' && block.children) {
            const style = block.style || 'normal';
            const content = block.children
              .map(child => renderTextWithMarks(child, block.markDefs))
              .join('');

            if (style === 'h2') {
              return <h2 set:html={content} />;
            } else if (style === 'h3') {
              return <h3 set:html={content} />;
            } else if (style === 'h4') {
              return <h4 set:html={content} />;
            } else if (style === 'blockquote') {
              return <blockquote set:html={content} />;
            } else {
              return <p set:html={content} />;
            }
          }

          if (block._type === 'image') {
            const imgUrl = urlFor(block).url();
            return (
              <figure>
                <img src={imgUrl} alt={block.alt || ''} />
                {block.caption && <figcaption>{block.caption}</figcaption>}
              </figure>
            );
          }

          return null;
        })}

        {footnotes.length > 0 && (
          <section class="footnotes">
            <h2>Notes</h2>
            <ol>
              {footnotes.map((footnote) => (
                <li id={`footnote-${footnote.key}`}>
                  {footnote.text}
                  <a href={`#ref-${footnote.key}`} class="footnote-back"> ↩</a>
                </li>
              ))}
            </ol>
          </section>
        )}
      </>
    ) : (
      <p><em>No content available for this post.</em></p>
    )}
  </div>
</ArticlePost>

<style>
  .article-content {
    max-width: 65ch;
    margin: 0 auto;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    font-family: 'Caudex', Georgia, serif;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-content :global(h2) {
    font-size: 1.875rem;
  }

  .article-content :global(h3) {
    font-size: 1.5rem;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid #c74a00;
    padding-left: 1.5em;
    margin: 2rem 0;
    font-style: italic;
  }

  .article-content :global(figure) {
    margin: 2rem 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .article-content :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #6b7280;
    font-style: italic;
    text-align: center;
  }

  .article-content :global(.footnote-ref) {
    text-decoration: none;
    color: #c74a00;
    font-weight: bold;
    margin-left: 0.125rem;
  }

  .footnotes {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #e5e7eb;
  }

  .footnotes h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-family: 'Caudex', Georgia, serif;
  }

  .footnotes ol {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .footnotes li {
    margin-bottom: 0.5rem;
  }

  .footnotes :global(.footnote-back) {
    margin-left: 0.25rem;
    text-decoration: none;
  }
</style>