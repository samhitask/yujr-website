---
import { client } from '../../lib/sanity';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = await client.fetch(`
  *[_type == "blogPost" && draft != true] | order(pubDate desc) {
    _id,
    title,
    "slug": slug.current,
    description,
    author,
    pubDate,
    image,
    tags
  }
`);

const url = new URL(Astro.request.url);
const authorFilter = url.searchParams.get('author');

const filteredPosts = authorFilter
  ? posts.filter(post => post.author === authorFilter)
  : posts;

const pageTitle = authorFilter ? `Blog Posts by ${authorFilter}` : 'Blog';
const pageSubtitle = authorFilter
  ? `All blog posts written by ${authorFilter}`
  : 'Commentary and perspectives from the Yale Undergraduate Journal of Religion';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead title="Blog" description="Browse blog posts from the Yale Undergraduate Journal of Religion" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent: #c74a00;
      --accent-rgb: 199, 74, 0;
      --text-heading: #1a1a1a;
      --text: #333333;
      --text-muted: #666666;
      --border-color: #e0e0e0;
      --white: #ffffff;
      --background-light: #fafafa;
    }
    * { box-sizing: border-box; }
    body { font-family: 'Lato', sans-serif; margin: 0; padding: 0; background-color: var(--white); color: var(--text); }

    /* ── Hero ── */
    .hero-header {
      position: relative;
      height: 70vh;
      min-height: 480px;
      display: flex;
      align-items: flex-end;
      background-image: url('/images/uploads/ivona-roz--5J-znfFA9w-unsplash.jpg');
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }
    .hero-header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.65) 100%);
      z-index: 1;
    }
    .hero-text {
      position: relative;
      z-index: 2;
      padding: 3rem clamp(2rem, 8vw, 6rem);
      max-width: 900px;
    }
    .hero-eyebrow {
      font-family: 'Lato', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: rgba(255,255,255,0.7);
      margin-bottom: 1rem;
      display: block;
      animation: fadeUp 0.8s ease both;
    }
    .hero-header h1 {
      font-family: 'Caudex', Georgia, serif;
      font-size: clamp(3.5rem, 8vw, 6rem);
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.03em;
      line-height: 1;
      margin: 0;
      text-shadow: 0 2px 20px rgba(0,0,0,0.3);
      animation: fadeUp 0.8s ease 0.1s both;
    }
    .hero-rule {
      width: 60px;
      height: 3px;
      background: var(--accent);
      margin-top: 1.5rem;
      animation: expandWidth 0.8s ease 0.3s both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes expandWidth {
      from { width: 0; }
      to   { width: 60px; }
    }

    /* ── Content ── */
    .content-container {
      max-width: 800px;
      width: 100%;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 2rem);
    }
    .empty-state {
      text-align: center;
      padding: 6rem 2rem;
      color: var(--text-muted);
      font-size: 1.125rem;
    }
    .featured-article {
      padding: 4rem 0;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 3rem;
    }
    .featured-label {
      font-family: 'Lato', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 1.5rem;
      display: block;
    }
    .featured-article .article-title {
      font-family: 'Caudex', Georgia, serif;
      font-size: 2.75rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--text-heading);
      margin: 0 0 1.25rem 0;
      letter-spacing: -0.02em;
    }
    .featured-article .article-meta {
      font-family: 'Lato', sans-serif;
      font-size: 0.9rem;
      color: var(--text-muted);
      margin: 0 0 1.5rem 0;
      font-weight: 400;
    }
    .featured-article .article-description {
      font-family: 'Lato', sans-serif;
      font-size: 1.25rem;
      line-height: 1.7;
      color: var(--text);
      margin: 0;
      font-weight: 300;
    }
    .featured-article .article-link {
      text-decoration: none;
      color: inherit;
      display: block;
      transition: opacity 0.2s ease;
    }
    .featured-article .article-link:hover { opacity: 0.85; }
    .featured-article .article-link:hover .article-title { color: var(--accent); }
    .articles-list { padding-bottom: 4rem; }
    .article-item {
      padding: 2.5rem 0;
      border-bottom: 1px solid var(--border-color);
    }
    .article-item:last-child { border-bottom: none; }
    .article-link {
      text-decoration: none;
      color: inherit;
      display: block;
      transition: opacity 0.2s ease;
    }
    .article-link:hover { opacity: 0.85; }
    .category {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--accent);
      margin-bottom: 0.75rem;
      display: inline-block;
    }
    .article-title {
      font-family: 'Caudex', Georgia, serif;
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--text-heading);
      margin: 0 0 0.75rem 0;
      letter-spacing: -0.01em;
    }
    .article-link:hover .article-title { color: var(--accent); }
    .article-meta {
      font-family: 'Lato', sans-serif;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin: 0 0 1rem 0;
      font-weight: 400;
    }
    .author-link {
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: all 0.2s ease;
    }
    .author-link:hover { color: var(--accent); border-bottom-color: var(--accent); }
    .meta-separator { margin: 0 0.5rem; color: var(--text-muted); }
    .pub-date { font-style: italic; }
    .article-description {
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      line-height: 1.7;
      color: var(--text);
      margin: 0;
      font-weight: 300;
    }
    @media (max-width: 768px) {
      .featured-article { padding: 3rem 0; margin-bottom: 2rem; }
      .featured-article .article-title { font-size: 2rem; }
      .featured-article .article-description { font-size: 1.1rem; }
      .article-item { padding: 2rem 0; }
      .article-title { font-size: 1.5rem; }
    }
  </style>
</head>

<body>
  <Header />

  <div class="hero-header">
    <div class="hero-text">
      <span class="hero-eyebrow">Yale Undergraduate Journal of Religion</span>
      <h1>{pageTitle}</h1>
      <div class="hero-rule"></div>
    </div>
  </div>

  <main id="content" class="content-container">
    {filteredPosts.length === 0 ? (
      <div class="empty-state">
        <p>{authorFilter ? `No blog posts found by ${authorFilter}.` : 'No blog posts yet. Coming soon!'}</p>
        {authorFilter && (
          <p><a href="/blog" style="color: #c74a00; text-decoration: none; border-bottom: 1px solid #c74a00;">View all blog posts</a></p>
        )}
      </div>
    ) : (
      <>
        {filteredPosts.slice(0, 1).map((post) => {
          const date = new Date(post.pubDate);
          const formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
          return (
            <article class="featured-article">
              <a href={`/blog/${post.slug}`} class="article-link">
                <span class="featured-label">Latest</span>
                {post.tags && post.tags.length > 0 && <div class="category">{post.tags[0]}</div>}
                <h2 class="article-title">{post.title}</h2>
              </a>
              <p class="article-meta">
                {post.author && (
                  <>
                    <a href={`/blog?author=${encodeURIComponent(post.author)}`} class="author-link">{post.author}</a>
                    <span class="meta-separator">·</span>
                  </>
                )}
                <span class="pub-date">{formattedDate}</span>
              </p>
              <a href={`/blog/${post.slug}`} class="article-link">
                {post.description && <p class="article-description">{post.description}</p>}
              </a>
            </article>
          );
        })}
        <div class="articles-list">
          {filteredPosts.slice(1).map((post) => {
            const date = new Date(post.pubDate);
            const formattedDate = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
            return (
              <article class="article-item">
                <a href={`/blog/${post.slug}`} class="article-link">
                  {post.tags && post.tags.length > 0 && <div class="category">{post.tags[0]}</div>}
                  <h3 class="article-title">{post.title}</h3>
                </a>
                <p class="article-meta">
                  {post.author && (
                    <>
                      <a href={`/blog?author=${encodeURIComponent(post.author)}`} class="author-link">{post.author}</a>
                      <span class="meta-separator">·</span>
                    </>
                  )}
                  <span class="pub-date">{formattedDate}</span>
                </p>
                <a href={`/blog/${post.slug}`} class="article-link">
                  {post.description && <p class="article-description">{post.description}</p>}
                </a>
              </article>
            );
          })}
        </div>
      </>
    )}
  </main>

  <Footer />
</body>
</html>