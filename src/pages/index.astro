---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { client } from '../lib/sanity';

// Get the 4 most recent articles from Sanity
const posts = await client.fetch(`
  *[_type == "article" && draft != true] | order(pubDate desc)[0...4] {
    _id,
    title,
    "slug": slug.current,
    description,
    author,
    pubDate,
    image,
    tags
  }
`);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
	<style>
		:root {
			--accent: #c74a00;
			--accent-rgb: 199, 74, 0;
			--text-heading: #1a1a1a;
			--text: #333333;
			--text-muted: #666666;
			--border-color: #e8e8e8;
			--white: #ffffff;
			--background-light: #fafafa;
		}

		* {
			box-sizing: border-box;
		}

		body {
			font-family: 'Lato', sans-serif;
			margin: 0;
			padding: 0;
		}

		.journal-cover {
			background-image: url('/images/uploads/claire-satera-gd21U8VUsLc-unsplash.jpg'); 
			background-size: cover; 
			background-position: center; 
			background-repeat: no-repeat;
			position: relative;
			padding: 8rem 1rem 6rem;
			text-align: center;
			overflow: hidden;
		}

		.journal-cover::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background-color: rgba(0, 0, 0, 0.5);
			z-index: 1;
		}

		.journal-title {
			position: relative; 
			z-index: 2;
		}

		.title-text {
			font-family: 'Caudex', Georgia, serif;
			color: #ffffff;
			margin: 0 0 1rem 0;
			font-size: 3.5rem;
			text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
			font-weight: 700;
			letter-spacing: -0.02em;
		}

		.journal-description {
			font-family: 'Lato', sans-serif;
			color: #ffffff;
			font-size: 1.25rem;
			text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			margin: 0;
			max-width: 600px;
			margin: 0 auto;
		}

		@media (min-width: 768px) {
			.title-text {
				font-size: 4.5rem;
			}
		}

		.content-container {
			max-width: 1100px;
			margin: 0 auto;
			padding: 4rem clamp(1rem, 5vw, 2rem);
		}

		.blog-section h2 {
			font-family: 'Caudex', Georgia, serif;
			font-size: 2.5rem;
			font-weight: 700;
			color: var(--text-heading);
			margin-bottom: 3rem;
			text-align: center;
			position: relative;
		}

		.post-grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 0;
			margin-bottom: 3rem;
		}

		.post-card {
			display: grid;
			grid-template-columns: 140px 1fr;
			gap: 2rem;
			padding: 2.5rem 0;
			border-bottom: 1px solid var(--border-color);
			transition: background-color 0.3s ease;
		}

		.post-card:hover {
			background-color: rgba(var(--accent-rgb), 0.02);
		}

		.post-card:first-child {
			grid-template-columns: 1fr;
			background-color: var(--background-light);
			padding: 3rem 2.5rem;
			margin: 0 -2.5rem 0;
			border-bottom: 3px solid var(--accent);
		}

		.post-card:first-child .date-column {
			display: none;
		}

		.post-card:first-child .post-title {
			font-size: 2.25rem;
		}

		.post-card:first-child .post-excerpt {
			font-size: 1.15rem;
			max-width: 800px;
		}

		.post-card:first-child .featured-badge {
			display: inline-block;
		}

		.date-column {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-start;
			padding-top: 0.25rem;
		}

		.pub-date {
			font-family: 'Caudex', Georgia, serif;
			text-align: center;
		}

		.date-month {
			font-size: 0.875rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--accent);
			font-weight: 700;
			margin-bottom: 0.25rem;
		}

		.date-day {
			font-size: 2.5rem;
			font-weight: 700;
			color: var(--text-heading);
			line-height: 1;
			margin-bottom: 0.25rem;
		}

		.date-year {
			font-size: 0.875rem;
			color: var(--text-muted);
			font-weight: 400;
		}

		.post-content {
			min-width: 0;
		}

		.featured-badge {
			display: none;
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--accent);
			margin-bottom: 1rem;
			padding: 0.5rem 1rem;
			border: 2px solid var(--accent);
			border-radius: 4px;
		}

		.post-title {
			font-family: 'Caudex', Georgia, serif;
			font-size: 1.75rem;
			font-weight: 700;
			line-height: 1.3;
			margin: 0 0 0.75rem 0;
		}

		.post-title a {
			color: var(--text-heading);
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.post-title a:hover {
			color: var(--accent);
		}

		.post-date {
			font-family: 'Lato', sans-serif;
			font-size: 0.875rem;
			color: var(--text-muted);
			margin: 0 0 0.75rem 0;
			font-weight: 700;
		}

		.post-excerpt {
			font-family: 'Lato', sans-serif;
			font-size: 1rem;
			line-height: 1.65;
			color: var(--text);
			margin: 0 0 1rem 0;
		}

		.read-more {
			font-family: 'Lato', sans-serif;
			font-size: 0.9rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--accent);
			text-decoration: none;
			border-bottom: 2px solid var(--accent);
			padding-bottom: 2px;
			transition: color 0.2s ease, border-color 0.2s ease;
		}

		.read-more:hover {
			color: var(--text-heading);
			border-color: var(--text-heading);
		}

		.view-all {
			text-align: center;
			margin-top: 3rem;
		}

		.view-all a {
			font-family: 'Lato', sans-serif;
			display: inline-block;
			padding: 1rem 2.5rem;
			background-color: var(--accent);
			color: var(--white);
			text-decoration: none;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			font-size: 0.9rem;
			border-radius: 4px;
			transition: background-color 0.3s ease, transform 0.2s ease;
		}

		.view-all a:hover {
			background-color: #a03d00;
			transform: translateY(-2px);
		}

		@media (max-width: 768px) {
			.journal-cover {
				padding: 5rem 1rem 3.5rem;
			}

			.title-text {
				font-size: 2.5rem;
			}

			.journal-description {
				font-size: 1.1rem;
			}

			.content-container {
				padding: 2rem 1rem;
			}

			.blog-section h2 {
				font-size: 2rem;
			}

			.post-card {
				grid-template-columns: 1fr;
				gap: 1rem;
				padding: 2rem 0;
			}

			.post-card:first-child {
				margin: 0;
				padding: 2rem 1.5rem;
			}

			.post-card:first-child .post-title {
				font-size: 1.75rem;
			}

			.post-card:first-child .post-excerpt {
				font-size: 1.05rem;
			}

			.date-column {
				flex-direction: row;
				align-items: baseline;
				gap: 0.5rem;
				padding-top: 0;
			}

			.date-day {
				font-size: 1.5rem;
			}

			.date-month,
			.date-year {
				font-size: 0.8rem;
			}

			.post-title {
				font-size: 1.5rem;
			}
		}
	</style>
	</head>
	
	<body>
		<div class="journal-cover">
			<div class="journal-title">
				<h1 class="title-text">{SITE_TITLE}</h1>
				<p class="journal-description">{SITE_DESCRIPTION}</p>
			</div>
		</div>

		<Header />
		
		<main id="content" class="content-container">
			<section class="blog-section">
				<h2>Latest Articles</h2>
				<div class="post-grid">
					{posts.map((post, index) => {
						const date = new Date(post.pubDate);
						const month = date.toLocaleDateString('en-US', { month: 'short' });
						const day = date.getDate();
						const year = date.getFullYear();

						return (
							<article class="post-card">
								<div class="date-column">
									<div class="pub-date">
										<div class="date-month">{month}</div>
										<div class="date-day">{day}</div>
										<div class="date-year">{year}</div>
									</div>
								</div>
								
								<div class="post-content">
									{index === 0 && <span class="featured-badge">Featured</span>}
									<h3 class="post-title">
										<a href={`/articles/${post.slug}/`}>{post.title}</a>
									</h3>
									<p class="post-date">{post.author}</p>
									<p class="post-excerpt">{post.description}</p>
									<a href={`/articles/${post.slug}/`} class="read-more">Read Article →</a>
								</div>
							</article>
						);
					})}
				</div>
				<div class="view-all">
					<a href="/articles">View All Articles</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>