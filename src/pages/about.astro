---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <BaseHead title={`About Us | ${SITE_TITLE}`} description="Learn about the Yale Undergraduate Journal of Research team." />
  <link href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400;1,700&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent: #c74a00;
      --accent-rgb: 199, 74, 0;
      --text-heading: #1a1a1a;
      --text: #333333;
      --text-muted: #666666;
      --border-color: #e0e0e0;
      --white: #ffffff;
      --background-light: #fafafa;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Lato', sans-serif;
      background-color: var(--white);
      color: var(--text);
    }

    /* ── Hero ── */
    .hero-header {
      position: relative;
      height: 70vh;
      min-height: 480px;
      display: flex;
      align-items: flex-end;
      background-image: url('/images/uploads/guillaume-bleyer-372uM1cIQqE-unsplash.jpg');
      background-size: cover;
      background-position: center;
      overflow: hidden;
    }

    .hero-header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.1) 0%,
        rgba(0,0,0,0.65) 100%
      );
      z-index: 1;
    }

    .hero-text {
      position: relative;
      z-index: 2;
      padding: 3rem clamp(2rem, 8vw, 6rem);
      max-width: 900px;
    }

    .hero-eyebrow {
      font-family: 'Lato', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: rgba(255,255,255,0.7);
      margin-bottom: 1rem;
      display: block;
      animation: fadeUp 0.8s ease both;
    }

    .hero-header h1 {
      font-family: 'Caudex', Georgia, serif;
      font-size: clamp(3.5rem, 8vw, 6rem);
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.03em;
      line-height: 1;
      text-shadow: 0 2px 20px rgba(0,0,0,0.3);
      animation: fadeUp 0.8s ease 0.1s both;
    }

    .hero-rule {
      width: 60px;
      height: 3px;
      background: var(--accent);
      margin-top: 1.5rem;
      animation: expandWidth 0.8s ease 0.3s both;
    }

    /* ── Main layout ── */
    .page-body {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 5vw, 4rem);
    }

    /* ── Mission ── */
    .mission-section {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
      align-items: start;
      padding: 6rem 0;
      border-bottom: 1px solid var(--border-color);
    }

    .mission-label {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--accent);
      padding-top: 0.4rem;
    }

    .mission-section h2 {
      font-family: 'Caudex', Georgia, serif;
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--text-heading);
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
    }

    .mission-text {
      font-family: 'Lato', sans-serif;
      font-size: 1.05rem;
      line-height: 1.85;
      color: var(--text);
      font-weight: 300;
    }

    /* ── Masthead ── */
    .masthead-section {
      padding: 6rem 0;
    }

    .masthead-header {
      display: flex;
      align-items: baseline;
      gap: 2rem;
      margin-bottom: 4rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border-color);
    }

    .masthead-header h2 {
      font-family: 'Caudex', Georgia, serif;
      font-size: 3rem;
      font-weight: 700;
      color: var(--text-heading);
      letter-spacing: -0.03em;
    }

    .masthead-year {
      font-family: 'Lato', sans-serif;
      font-size: 1rem;
      font-weight: 300;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    /* ── Animations ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes expandWidth {
      from { width: 0; }
      to   { width: 60px; }
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .mission-section {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 4rem 0;
      }

      .eic-block {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .eic-name { font-size: 2rem; }

      .masthead-header {
        flex-direction: column;
        gap: 0.5rem;
      }
    }
  </style>
</head>
<body>
  <Header />

  <div class="hero-header">
    <div class="hero-text">
      <span class="hero-eyebrow">Yale Undergraduate Journal of Religion</span>
      <h1>About Us</h1>
      <div class="hero-rule"></div>
    </div>
  </div>

  <main class="page-body">

    <!-- Mission -->
    <section class="mission-section">
      <div>
        <span class="mission-label">Our Mission</span>
      </div>
      <div>
        <h2>Advancing undergraduate scholarship in religious studies</h2>
        <p class="mission-text">
          The Yale Undergraduate Journal of Religion (YUJR) is a student-run publication dedicated to showcasing excellence in undergraduate research in religious studies. Founded to foster critical inquiry into the wide-ranging practices, ideologies, and societal impacts of religion, YUJR embraces interdisciplinary approaches, including sociology, anthropology, psychology, and history. By publishing thoughtful and innovative scholarship, YUJR provides a platform for students to engage with the academic study of religion, cultivating skills in analytical writing, peer review, and intellectual dialogue. The Journal publishes an annual issue and hosts events to promote engagement with the field of religious studies.
        </p>
      </div>
    </section>

    <!-- Masthead -->
    <section class="masthead-section">
      <div class="masthead-header">
        <h2>Masthead</h2>
        <span class="masthead-year">2025–26</span>
      </div>

      <div class="editors-list">
        <p>Owen Hannon, Editor-in-Chief</p>
        <p>Lucas Ranfranz, Treasurer</p>
        <p>Christopher Kim, Managing Editor</p>
        <p>Adam Buchsbaum, Outreach Director</p>
        <p>Matthew Mendelsohn, Blog Director</p>
        <p>Samhita Kumar, Website Designer</p>
      </div>
    </section>

  </main>

  <Footer />
</body>
</html>